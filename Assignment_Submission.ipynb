    "## 2. Utility Functions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Reproducibility\n",
    "def set_seed(seed: int = 42) -> None:\n",
    "    \"\"\"Set seed for reproducibility across all libraries.\"\"\"\n",
    "    random.seed(seed)\n",
    "    np.random.seed(seed)\n",
    "    torch.manual_seed(seed)\n",
    "    if torch.cuda.is_available():\n",
    "        torch.cuda.manual_seed_all(seed)\n",
    "\n",
    "set_seed(config.SEED)\n",
    "print(f\"Seed set to {config.SEED}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# SQuAD-style text normalisation\n",
    "_ARTICLES = re.compile(r\"\\b(a|an|the)\\b\", flags=re.UNICODE)\n",
    "_PUNCT = set(string.punctuation)\n",
    "\n",
    "def normalize_answer(text: str) -> str:\n",
    "    \"\"\"Lower-case, strip articles + punctuation, collapse whitespace.\"\"\"\n",
    "    if text is None:\n",
    "        return \"\"\n",
    "    text = text.lower()\n",
    "    text = \"\".join(ch for ch in text if ch not in _PUNCT)\n",
    "    text = _ARTICLES.sub(\" \", text)\n",
    "    text = \" \".join(text.split())\n",
    "    return text\n",
    "\n",
    "def exact_match(pred: str, gold: str) -> int:\n",
    "    return int(normalize_answer(pred) == normalize_answer(gold))\n",
    "\n",
    "def f1_score(pred: str, gold: str) -> float:\n",
    "    \"\"\"Token-level F1 between two strings after normalisation.\"\"\"\n",
    "    p_tokens = normalize_answer(pred).split()\n",
    "    g_tokens = normalize_answer(gold).split()\n",
    "    if not p_tokens or not g_tokens:\n",
    "        return float(p_tokens == g_tokens)\n",
    "    common = Counter(p_tokens) & Counter(g_tokens)\n",
    "    overlap = sum(common.values())\n",
    "    if overlap == 0:\n",
    "        return 0.0\n",
    "    precision = overlap / len(p_tokens)\n",
    "    recall = overlap / len(g_tokens)\n",
    "    return 2 * precision * recall / (precision + recall)\n",
    "\n",
    "def best_match_against_golds(pred: str, golds: Iterable[str]) -> tuple[int, float]:\n",
    "    \"\"\"Return (best_em, best_f1) of `pred` against any of the gold answers.\"\"\"\n",
    "    golds = list(golds) or [\"\"]\n",
    "    em = max(exact_match(pred, g) for g in golds)\n",
    "    f1 = max(f1_score(pred, g) for g in golds)\n",
    "    return em, f1\n",
    "\n",
    "def is_unanswerable(golds: Iterable[str]) -> bool:\n",
    "    \"\"\"SQuAD v2: a question is unanswerable iff every gold answer is empty.\"\"\"\n",
    "    golds = list(golds)\n",
    "    return len(golds) == 0 or all(not g.strip() for g in golds)\n",
    "\n",
    "def save_json(obj, path: Path) -> None:\n",
    "    \"\"\"Save object to JSON file.\"\"\"\n",
    "    path.parent.mkdir(parents=True, exist_ok=True)\n",
    "    with open(path, \"w\") as f:\n",
    "        json.dump(obj, f, indent=2)\n",
    "\n",
    "print(\"✓ Utility functions loaded\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Data Loading"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from datasets import load_dataset\n",
    "\n",
    "@dataclass\n",
    "class SQuADExample:\n",
    "    \"\"\"A single SQuAD v2 example.\"\"\"\n",
    "    qid: str\n",
    "    question: str\n",
    "    context: str\n",
    "    answer_start: int\n",
    "    answer_text: str\n",
    "    is_impossible: bool\n",
    "    title: str\n",
    "    \n",
    "    def to_dict(self):\n",
    "        return {\n",
    "            \"qid\": self.qid,\n",
    "            \"question\": self.question,\n",
    "            \"context\": self.context,\n",
    "            \"answer_start\": self.answer_start,\n",
    "            \"answer_text\": self.answer_text,\n",
    "            \"is_impossible\": self.is_impossible,\n",
    "            \"title\": self.title,\n",
    "        }\n",
    "\n",
    "def load_squad_v2(\n",
    "    dataset_name: str = config.DATASET_NAME,\n",
    "    split: str = config.DATASET_SPLIT,\n",
    "    sample_size: int = None,\n",
    "    answerable_ratio: float = 0.5,\n",
    "    seed: int = 42,\n",
    ") -> list[SQuADExample]:\n",
    "    \"\"\"Load and optionally sample from SQuAD v2.0.\"\"\"\n",
    "    print(f\"Loading {dataset_name} ({split})...\")\n",
    "    dataset = load_dataset(dataset_name, split=split)\n",
    "    \n",
    "    examples = []\n",
    "    for item in dataset:\n",
    "        for qa in item[\"qas\"]:\n",
    "            # Extract answers\n",
    "            answers = qa.get(\"answers\", [])\n",
    "            answer_text = answers[0][\"text\"] if answers else \"\"\n",
    "            answer_start = answers[0][\"answer_start\"] if answers else -1\n",
    "            \n",
    "            example = SQuADExample(\n",
    "                qid=qa[\"id\"],\n",
    "                question=qa[\"question\"],\n",
    "                context=item[\"context\"],\n",
    "                answer_start=answer_start,\n",
    "                answer_text=answer_text,\n",
    "                is_impossible=qa.get(\"is_impossible\", False),\n",
    "                title=item.get(\"title\", \"\"),\n",
    "            )\n",
    "            examples.append(example)\n",
    "    \n",
    "    # Stratified sampling if requested\n",
    "    if sample_size and sample_size < len(examples):\n",
    "        rng = np.random.RandomState(seed)\n",
    "        answerables = [e for e in examples if not e.is_impossible]\n",
    "        unanswerables = [e for e in examples if e.is_impossible]\n",
    "        \n",
    "        n_answerables = int(sample_size * answerable_ratio)\n",
    "        n_unanswerables = sample_size - n_answerables\n",
    "        \n",
    "        sampled_answerables = rng.choice(answerables, min(n_answerables, len(answerables)), replace=False)\n",
    "        sampled_unanswerables = rng.choice(unanswerables, min(n_unanswerables, len(unanswerables)), replace=False)\n",
    "        \n",
    "        examples = list(sampled_answerables) + list(sampled_unanswerables)\n",
    "        rng.shuffle(examples)\n",
    "    \n",
    "    return examples\n",
    "\n",
    "def build_corpus(examples: list[SQuADExample]) -> tuple[list[str], list[str], dict]:\n",
    "    \"\"\"Build unique document corpus and map questions to gold documents.\"\"\"\n",
    "    doc_texts = []\n",
    "    doc_ids = []\n",
    "    qid_to_gold_doc = {}\n",
    "    \n",
    "    seen_docs = set()\n",
    "    for ex in examples:\n",
    "        doc_id = ex.title\n",
    "        if doc_id not in seen_docs:\n",
    "            doc_ids.append(doc_id)\n",
    "            doc_texts.append(ex.context)\n",
    "            seen_docs.add(doc_id)\n",
    "        qid_to_gold_doc[ex.qid] = doc_id\n",
    "    \n",
    "    return doc_ids, doc_texts, qid_to_gold_doc\n",
    "\n",
    "# Load data\n",
    "print(\"Loading SQuAD v2.0 data...\")\n",
    "examples = load_squad_v2(\n",
    "    dataset_name=config.DATASET_NAME,\n",
    "    split=config.DATASET_SPLIT,\n",
    "    sample_size=config.SAMPLE_SIZE,\n",
    "    answerable_ratio=config.ANSWERABLE_RATIO,\n",
    "    seed=config.SEED,\n",
    ")\n",
    "doc_ids, doc_texts, qid_to_gold_doc = build_corpus(examples)\n",
    "\n",
    "print(f\"✓ Loaded {len(examples)} questions from {len(doc_ids)} unique documents\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Metrics Implementation (from scratch)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def reciprocal_rank(ranking: list[bool]) -> float:\n",
    "    \"\"\"Return reciprocal rank of first relevant item, or 0 if none found.\"\"\"\n",
    "    for i, is_relevant in enumerate(ranking, start=1):\n",
    "        if is_relevant:\n",
    "            return 1.0 / i\n",
    "    return 0.0\n",
    "\n",
    "def mean_reciprocal_rank(rankings: list[list[bool]]) -> float:\n",
    "    \"\"\"Compute MRR across multiple rankings.\"\"\"\n",
    "    return np.mean([reciprocal_rank(r) for r in rankings]) if rankings else 0.0\n",
    "\n",
    "def recall_at_k(ranking: list[bool], k: int) -> float:\n",
    "    \"\"\"Fraction of relevant items appearing in top-k.\"\"\"\n",
    "    n_relevant = sum(ranking)\n",
    "    if n_relevant == 0:\n",
    "        return 1.0  # No relevant items = trivially satisfied\n",
    "    n_relevant_in_top_k = sum(ranking[:k])\n",
    "    return n_relevant_in_top_k / n_relevant\n",
    "\n",
    "def recall_at_k_curve(ranking: list[bool], max_k: int = 10) -> dict[int, float]:\n",
    "    \"\"\"Return Recall@K for k=1 to max_k.\"\"\"\n",
    "    return {k: recall_at_k(ranking, k) for k in range(1, min(max_k + 1, len(ranking) + 1))}\n",
    "\n",
    "def average_precision(ranking: list[bool]) -> float:\n",
    "    \"\"\"Compute average precision (standard IR definition with de-duplication).\"\"\"\n",
    "    if sum(ranking) == 0:\n",
    "        return 1.0  # No relevant items = trivially satisfied\n",
    "    \n",
    "    score = 0.0\n",
    "    num_relevant_so_far = 0\n",
    "    for i, is_relevant in enumerate(ranking):\n",
    "        if is_relevant:\n",
    "            num_relevant_so_far += 1\n",
    "            precision_at_i = num_relevant_so_far / (i + 1)\n",
    "            score += precision_at_i\n",
    "    \n",
    "    return score / sum(ranking)\n",
    "\n",
    "def mean_average_precision(rankings: list[list[bool]]) -> float:\n",
    "    \"\"\"Compute MAP across multiple rankings.\"\"\"\n",
    "    return np.mean([average_precision(r) for r in rankings]) if rankings else 0.0\n",
    "\n",
    "print(\"✓ Metrics functions loaded\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Pipeline A: Extractive QA"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from transformers import AutoTokenizer, AutoModelForQuestionAnswering\n",
    "\n",
    "@dataclass\n",
    "class ExtractiveQAPrediction:\n",
    "    \"\"\"Prediction from the extractive QA model.\"\"\"\n",
    "    qid: str\n",
    "    question: str\n",
    "    context: str\n",
    "    answer: str\n",
    "    score: float\n",
    "    start_idx: int\n",
    "    end_idx: int\n",
    "    no_answer: bool\n",
    "    \n",
    "    def to_dict(self):\n",
    "        return {\n",
    "            \"qid\": self.qid,\n",
    "            \"question\": self.question,\n",
    "            \"answer\": self.answer,\n",
    "            \"score\": float(self.score),\n",
    "            \"no_answer\": self.no_answer,\n",
    "        }\n",
    "\n",
    "class ExtractiveQA:\n",
    "    \"\"\"Extractive QA using a fine-tuned RoBERTa model.\"\"\"\n",
    "    \n",
    "    def __init__(\n",
    "        self,\n",
    "        model_name: str = config.EXTRACTIVE_MODEL,\n",
    "        device: str = \"cpu\",\n",
    "        max_answer_len: int = 30,\n",
    "        top_k: int = 10,\n",
    "        null_threshold: float = 0.0,\n",
    "    ):\n",
    "        self.model_name = model_name\n",
    "        self.device = device\n",
    "        self.max_answer_len = max_answer_len\n",
    "        self.top_k = top_k\n",
    "        self.null_threshold = null_threshold\n",
    "        \n",
    "        self.tokenizer = AutoTokenizer.from_pretrained(model_name)\n",
    "        self.model = AutoModelForQuestionAnswering.from_pretrained(model_name).to(device).eval()\n",
    "    \n",
    "    def predict_batch(self, examples: list[SQuADExample]) -> list[ExtractiveQAPrediction]:\n",
    "        \"\"\"Run extractive QA on a batch of examples.\"\"\"\n",
    "        predictions = []\n",
    "        \n",
    "        for ex in tqdm(examples, desc=\"Extractive QA\"):\n",
    "            # Tokenize input\n",
    "            inputs = self.tokenizer(\n",
    "                ex.question,\n",
    "                ex.context,\n",
    "                max_length=512,\n",
    "                truncation=\"only_second\",\n",
    "                return_tensors=\"pt\",\n",
    "            ).to(self.device)\n",
    "            \n",
    "            with torch.no_grad():\n",
    "                outputs = self.model(**inputs)\n",
    "            \n",
    "            # Extract top-k spans\n",
    "            start_scores = torch.softmax(outputs.start_logits, dim=-1)\n",
    "            end_scores = torch.softmax(outputs.end_logits, dim=-1)\n",
    "            \n",
    "            start_probs, start_indices = torch.topk(start_scores[0], min(self.top_k, start_scores.shape[1]))\n",
    "            end_probs, end_indices = torch.topk(end_scores[0], min(self.top_k, end_scores.shape[1]))\n",
    "            \n",
    "            # Get top span\n",
    "            best_score = 0.0\n",
    "            best_start = 0\n",
    "            best_end = 0\n",
    "            \n",
    "            for start_idx in start_indices:\n",
    "                for end_idx in end_indices:\n",
    "                    if end_idx >= start_idx and end_idx - start_idx + 1 <= self.max_answer_len:\n",
    "                        score = start_probs[list(start_indices).index(start_idx)].item() * end_probs[list(end_indices).index(end_idx)].item()\n",
    "                        if score > best_score:\n",
    "                            best_score = score\n",
    "                            best_start = start_idx.item()\n",
    "                            best_end = end_idx.item()\n",
    "            \n",
    "            # Decode answer\n",
    "            answer_tokens = inputs.input_ids[0, best_start:best_end+1]\n",
    "            answer = self.tokenizer.decode(answer_tokens, skip_special_tokens=True)\n",
    "            \n",
    "            no_answer = best_score < self.null_threshold\n",
    "            \n",
    "            pred = ExtractiveQAPrediction(\n",
    "                qid=ex.qid,\n",
    "                question=ex.question,\n",
    "                context=ex.context,\n",
    "                answer=answer if not no_answer else \"\",\n",
    "                score=best_score,\n",
    "                start_idx=best_start,\n",
    "                end_idx=best_end,\n",
    "                no_answer=no_answer,\n",
    "            )\n",
    "            predictions.append(pred)\n",
    "        \n",
    "        return predictions\n",
    "\n",
    "print(\"✓ Extractive QA class loaded\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Run Pipeline A: Extractive QA\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"PIPELINE A: EXTRACTIVE QA\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "t0 = time.time()\n",
    "print(f\"Loading model: {config.EXTRACTIVE_MODEL}...\")\n",
    "ext = ExtractiveQA(\n",
    "    model_name=config.EXTRACTIVE_MODEL,\n",
    "    device=device,\n",
    "    max_answer_len=config.EXTRACTIVE_MAX_ANSWER_LEN,\n",
    "    top_k=config.EXTRACTIVE_TOP_K,\n",
    "    null_threshold=config.EXTRACTIVE_NULL_THRESHOLD,\n",
    ")\n",
    "print(f\"Model loaded in {time.time()-t0:.1f}s\")\n",
    "\n",
    "print(f\"\\nRunning extractive QA on {len(examples)} examples...\")\n",
    "ext_preds = ext.predict_batch(examples)\n",
    "print(f\"✓ Extractive QA completed in {time.time()-t0:.1f}s\")\n",
    "\n",
    "# Save predictions\n",
    "save_json([p.to_dict() for p in ext_preds], config.OUTPUT_DIR / \"extractive_predictions.json\")\n",
    "print(f\"✓ Predictions saved to {config.OUTPUT_DIR / 'extractive_predictions.json'}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Evaluation Functions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def evaluate_extractive(\n",
    "    examples: list[SQuADExample],\n",
    "    predictions: list[ExtractiveQAPrediction],\n",
    "    max_k: int = 10,\n",
    ") -> dict:\n",
    "    \"\"\"Evaluate extractive predictions on SQuAD metrics.\"\"\"\n",
    "    # Collect metrics\n",
    "    em_scores_top1 = []\n",
    "    f1_scores_top1 = []\n",
    "    mrr_scores = []\n",
    "    rankings = []\n",
    "    \n",
    "    for ex, pred in zip(examples, predictions):\n",
    "        # Top-1 EM/F1\n",
    "        gold_answers = [] if ex.is_impossible else [ex.answer_text]\n",
    "        em, f1 = best_match_against_golds(pred.answer, gold_answers)\n",
    "        em_scores_top1.append(em)\n",
    "        f1_scores_top1.append(f1)\n",
    "        \n",
    "        # For MRR/MAP, top-1 is relevant if EM=1\n",
    "        ranking = [em == 1]\n",
    "        rankings.append(ranking)\n",
    "        mrr_scores.append(reciprocal_rank(ranking))\n",
    "    \n",
    "    # Compute metrics\n",
    "    return {\n",
    "        \"top1_em\": float(np.mean(em_scores_top1)),\n",
    "        \"top1_f1\": float(np.mean(f1_scores_top1)),\n",
    "        \"mrr\": float(mean_reciprocal_rank(rankings)),\n",
    "        \"map\": float(mean_average_precision(rankings)),\n",
    "        \"recall_at_k\": {k: float(np.mean([recall_at_k(r, k) for r in rankings])) for k in range(1, max_k + 1)},\n",
    "    }\n",
    "\n",
    "# Evaluate extractive QA\n",
    "print(\"\\nEvaluating extractive predictions...\")\n",
    "ext_metrics = evaluate_extractive(examples, ext_preds, max_k=config.RETRIEVER_MAX_K_EVAL)\n",
    "save_json(ext_metrics, config.OUTPUT_DIR / \"extractive_metrics.json\")\n",
    "\n",
    "print(\"\\n\" + \"-\"*60)\n",
    "print(\"EXTRACTIVE QA RESULTS\")\n",
    "print(\"-\"*60)\n",
    "print(f\"Top-1 EM: {ext_metrics['top1_em']:.3f}\")\n",
    "print(f\"Top-1 F1: {ext_metrics['top1_f1']:.3f}\")\n",
    "print(f\"MRR: {ext_metrics['mrr']:.3f}\")\n",
    "print(f\"MAP: {ext_metrics['map']:.3f}\")\n",
    "print(f\"Recall@1: {ext_metrics['recall_at_k'][1]:.3f}\")\n",
    "print(f\"Recall@5: {ext_metrics['recall_at_k'][5]:.3f}\")\n",
    "print(\"-\"*60)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Pipeline B: RAG (Retrieval-Augmented Generation)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "from transformers import AutoModelForSeq2SeqLM\n",
    "\n",
    "class TFIDFRetriever:\n",
    "    \"\"\"Simple TF-IDF based retriever.\"\"\"\n",
    "    \n",
    "    def __init__(self):\n",
    "        self.vectorizer = TfidfVectorizer(max_features=5000, stop_words='english')\n",
    "        self.doc_ids = None\n",
    "        self.doc_tfidf = None\n",
    "    \n",
    "    def fit(self, doc_ids: list[str], doc_texts: list[str]):\n",
    "        \"\"\"Fit TF-IDF on documents.\"\"\"\n",
    "        self.doc_ids = doc_ids\n",
    "        self.doc_tfidf = self.vectorizer.fit_transform(doc_texts)\n",
    "        return self\n",
    "    \n",
    "    def retrieve(self, query: str, k: int = 5) -> list[str]:\n",
    "        \"\"\"Retrieve top-k documents for a query.\"\"\"\n",
    "        query_vec = self.vectorizer.transform([query])\n",
    "        scores = query_vec.dot(self.doc_tfidf.T).toarray()[0]\n",
    "        top_k_indices = np.argsort(-scores)[:k]\n",
    "        return [self.doc_ids[i] for i in top_k_indices if scores[i] > 0]\n",
    "\n",
    "@dataclass\n",
    "class RAGPrediction:\n",
    "    \"\"\"Prediction from the RAG pipeline.\"\"\"\n",
    "    qid: str\n",
    "    question: str\n",
    "    retrieved_doc_ids: list[str]\n",
    "    answer: str\n",
    "    no_answer: bool\n",
    "    \n",
    "    def to_dict(self):\n",
    "        return {\n",
    "            \"qid\": self.qid,\n",
    "            \"question\": self.question,\n",
    "            \"retrieved_doc_ids\": self.retrieved_doc_ids,\n",
    "            \"answer\": self.answer,\n",
    "            \"no_answer\": self.no_answer,\n",
    "        }\n",
    "\n",
    "class RAGPipeline:\n",
    "    \"\"\"RAG pipeline combining retrieval and generation.\"\"\"\n",
    "    \n",
    "    def __init__(\n",
    "        self,\n",
    "        retriever,\n",
    "        generator_model_name: str = config.GENERATIVE_MODEL,\n",
    "        device: str = \"cpu\",\n",
    "        top_k: int = 5,\n",
    "        max_new_tokens: int = 64,\n",
    "        num_beams: int = 4,\n",
    "    ):\n",
    "        self.retriever = retriever\n",
    "        self.device = device\n",
    "        self.top_k = top_k\n",
    "        self.max_new_tokens = max_new_tokens\n",
    "        self.num_beams = num_beams\n",
    "        \n",
    "        self.tokenizer = AutoTokenizer.from_pretrained(generator_model_name)\n",
    "        self.model = AutoModelForSeq2SeqLM.from_pretrained(generator_model_name).to(device).eval()\n",
    "    \n",
    "    def predict_batch(self, examples: list[SQuADExample]) -> list[RAGPrediction]:\n",
    "        \"\"\"Run RAG on a batch of examples.\"\"\"\n",
    "        predictions = []\n",
    "        \n",
    "        for ex in tqdm(examples, desc=\"RAG Pipeline\"):\n",
    "            # Retrieve documents\n",
    "            retrieved_docs = self.retriever.retrieve(ex.question, k=self.top_k)\n",
    "            \n",
    "            # Build context string\n",
    "            doc_idx_map = {doc_id: i for i, doc_id in enumerate(self.retriever.doc_ids)}\n",
    "            contexts = []\n",
    "            for doc_id in retrieved_docs:\n",
    "                if doc_id in doc_idx_map:\n",
    "                    idx = doc_idx_map[doc_id]\n",
    "                    contexts.append(self.retriever.doc_ids[idx])\n",
    "            \n",
    "            context_str = \"\\n\\n\".join(contexts) if contexts else \"No relevant documents found.\"\n",
    "            \n",
    "            # Generate answer\n",
    "            prompt = f\"Context: {context_str}\\n\\nQuestion: {ex.question}\\n\\nAnswer:\"\n",
    "            inputs = self.tokenizer(prompt, max_length=512, truncation=True, return_tensors=\"pt\").to(self.device)\n",
    "            \n",
    "            with torch.no_grad():\n",
    "                outputs = self.model.generate(\n",
    "                    inputs[\"input_ids\"],\n",
    "                    max_new_tokens=self.max_new_tokens,\n",
    "                    num_beams=self.num_beams,\n",
    "                    do_sample=False,\n",
    "                )\n",
    "            \n",
    "            answer = self.tokenizer.decode(outputs[0], skip_special_tokens=True).strip()\n",
    "            no_answer = answer.lower() in [\"no answer\", \"unable to answer\", \"cannot answer\"]\n",
    "            \n",
    "            pred = RAGPrediction(\n",
    "                qid=ex.qid,\n",
    "                question=ex.question,\n",
    "                retrieved_doc_ids=retrieved_docs,\n",
    "                answer=answer if not no_answer else \"\",\n",
    "                no_answer=no_answer,\n",
    "            )\n",
    "            predictions.append(pred)\n",
    "        \n",
    "        return predictions\n",
    "\n",
    "print(\"✓ RAG classes loaded\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Run Pipeline B: RAG\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"PIPELINE B: RETRIEVAL-AUGMENTED GENERATION (RAG)\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "t0 = time.time()\n",
    "print(\"Fitting TF-IDF retriever...\")\n",
    "retriever = TFIDFRetriever().fit(doc_ids, doc_texts)\n",
    "print(f\"Retriever fitted in {time.time()-t0:.1f}s\")\n",
    "\n",
    "print(f\"\\nLoading generator model: {config.GENERATIVE_MODEL}...\")\n",
    "rag = RAGPipeline(\n",
    "    retriever=retriever,\n",
    "    generator_model_name=config.GENERATIVE_MODEL,\n",
    "    device=device,\n",
    "    top_k=config.RETRIEVER_TOP_K,\n",
    "    max_new_tokens=config.GEN_MAX_NEW_TOKENS,\n",
    "    num_beams=config.GEN_NUM_BEAMS,\n",
    ")\n",
    "\n",
    "print(f\"\\nRunning RAG pipeline on {len(examples)} examples...\")\n",
    "rag_preds = rag.predict_batch(examples)\n",
    "print(f\"✓ RAG completed in {time.time()-t0:.1f}s\")\n",
    "\n",
    "# Save predictions\n",
    "save_json([p.to_dict() for p in rag_preds], config.OUTPUT_DIR / \"rag_predictions.json\")\n",
    "print(f\"✓ Predictions saved to {config.OUTPUT_DIR / 'rag_predictions.json'}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. RAG Evaluation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def evaluate_retrieval(\n",
    "    examples: list[SQuADExample],\n",
    "    predictions: list[RAGPrediction],\n",
    "    qid_to_gold_doc: dict,\n",
    "    max_k: int = 10,\n",
    ") -> dict:\n",
    "    \"\"\"Evaluate retrieval quality.\"\"\"\n",
    "    rankings = []\n",
    "    \n",
    "    for pred in predictions:\n",
    "        gold_doc = qid_to_gold_doc.get(pred.qid)\n",
    "        if gold_doc:\n",
    "            ranking = [doc_id == gold_doc for doc_id in pred.retrieved_doc_ids]\n",
    "        else:\n",
    "            ranking = [False] * len(pred.retrieved_doc_ids)\n",
    "        rankings.append(ranking)\n",
    "    \n",
    "    return {\n",
    "        \"mrr\": float(mean_reciprocal_rank(rankings)),\n",
    "        \"map\": float(mean_average_precision(rankings)),\n",
    "        \"recall_at_k\": {k: float(np.mean([recall_at_k(r, k) for r in rankings])) for k in range(1, max_k + 1)},\n",
    "    }\n",
    "\n",
    "def evaluate_rag_answers(\n",
    "    examples: list[SQuADExample],\n",
    "    predictions: list[RAGPrediction],\n",
    ") -> dict:\n",
    "    \"\"\"Evaluate answer generation quality.\"\"\"\n",
    "    em_scores = []\n",
    "    f1_scores = []\n",
    "    \n",
    "    for ex, pred in zip(examples, predictions):\n",
    "        gold_answers = [] if ex.is_impossible else [ex.answer_text]\n",
    "        em, f1 = best_match_against_golds(pred.answer, gold_answers)\n",
    "        em_scores.append(em)\n",
    "        f1_scores.append(f1)\n",
    "    \n",
    "    return {\n",
    "        \"em\": float(np.mean(em_scores)),\n",
    "        \"f1\": float(np.mean(f1_scores)),\n",
    "    }\n",
    "\n",
    "# Evaluate RAG\n",
    "print(\"\\nEvaluating RAG predictions...\")\n",
    "retrieval_metrics = evaluate_retrieval(examples, rag_preds, qid_to_gold_doc, max_k=config.RETRIEVER_MAX_K_EVAL)\n",
    "answer_metrics = evaluate_rag_answers(examples, rag_preds)\n",
    "save_json({\"retrieval\": retrieval_metrics, \"answers\": answer_metrics}, config.OUTPUT_DIR / \"rag_metrics.json\")\n",
    "\n",
    "print(\"\\n\" + \"-\"*60)\n",
    "print(\"RAG RETRIEVAL RESULTS\")\n",
    "print(\"-\"*60)\n",
    "print(f\"MRR: {retrieval_metrics['mrr']:.3f}\")\n",
    "print(f\"MAP: {retrieval_metrics['map']:.3f}\")\n",
    "print(f\"Recall@1: {retrieval_metrics['recall_at_k'][1]:.3f}\")\n",
    "print(f\"Recall@5: {retrieval_metrics['recall_at_k'][5]:.3f}\")\n",
    "print(\"\\n\" + \"-\"*60)\n",
    "print(\"RAG ANSWER GENERATION RESULTS\")\n",
    "print(\"-\"*60)\n",
    "print(f\"EM: {answer_metrics['em']:.3f}\")\n",
    "print(f\"F1: {answer_metrics['f1']:.3f}\")\n",
    "print(\"-\"*60)"
   ]
